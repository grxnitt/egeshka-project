BOT_TOKEN=replace_me
DATABASE_URL=sqlite+aiosqlite:///./egeshka.db
ADMIN_IDS=123456789
CHANNEL_URL=https://t.me/EgeMatch_blog
# Shown in the consent screen: who runs the service and how to reach them.
OPERATOR_NAME=replace_with_full_name_or_company
OPERATOR_CONTACT=replace_with_email_or_telegram
# Public values used by the website after the database cutover.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key

# Lead requests from the website ("Выбрать школу"). Off by default; turn on only on the Russian server,
# after the privacy policy and consent text have been reviewed and a school has been enabled in lead_schools.
LEADS_ENABLED=false
LEADS_PORT=8081
LEADS_ALLOWED_ORIGINS=https://egematch.ru,https://www.egematch.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
