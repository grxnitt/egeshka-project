[Unit]
Description=EGE Match site reviews (admin)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=egematch
Group=egematch
WorkingDirectory=/opt/egematch
EnvironmentFile=/etc/egematch/reviews-admin.env
ExecStart=/opt/egematch/.venv/bin/python -m reviews_service admin
Restart=always
RestartSec=5
# Hardening: read-only system, no new privileges, only the screenshots folder is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/egematch/proofs
MemoryMax=900M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
