data.egematch.ru {
	encode gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Requests to schools (leads service). Matched before the generic /api/* so the review service never sees them.
	@leads path /api/leads /api/leads/* /api/lead-schools /api/lead-consent
	handle @leads {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:8081
	}
	# Site reviews (reviews_service public API). Bodies above 31 MB are cut before they reach Python.
	handle /api/* {
		request_body {
			max_size 31MB
		}
		reverse_proxy 127.0.0.1:8085
	}
	# Read-only public data (PostgREST), with the Supabase-style prefix the site client uses.
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
